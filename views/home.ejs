<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            padding: 20px;
            background-color: #f4f4f4;
        }
        h1 {
            color: #333;
        }
        form {
            margin-top: 20px;
        }
        input[type="url"] {
            width: 300px;
            padding: 10px;
            margin-right: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        button {
            padding: 10px 15px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        button:hover {
            background-color: #218838;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page Vaibhav</title>
</head>
<body>
    <h1>Welcome to ShortURL Service</h1>  
    <div>
        <form action="/url" method="POST">
            <label for="originalUrl">Enter Your Original URL:</label>
            <input type="url" id="originalUrl" placeholder="http://example.com" name="url" required>
            <button type="submit">Shorten URL</button>
        </form>
    </div>  
</body>
</html>